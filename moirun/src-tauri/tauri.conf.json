{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "moirun",
	"version": "0.1.3",
	"identifier": "com.moirun.app",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "眸润",
				"width": 800,
				"height": 600,
				"visible": false,
				"decorations": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none';"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"entitlements": "./Entitlements.plist",
			"minimumSystemVersion": "10.15"
		}
	}
}
