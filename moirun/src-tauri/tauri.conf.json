{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moirun",
  "version": "0.1.0",
  "identifier": "com.moirun.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "眸润",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": true
      },
      {
        "label": "settings",
        "title": "设置",
        "width": 520,
        "height": 640,
        "visible": false,
        "decorations": true,
        "center": true
      },
      {
        "label": "eyecare",
        "title": "护眼提醒",
        "width": 420,
        "height": 320,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
